{
  "name": "@code-dot-org/maze",
  "version": "2.17.0",
  "description": "standalone project for the Maze app type",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.d.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc -b && node ./esbuild.bundle.js",
    "lint": "eslint .",
    "postversion": "git push && git push --tags && npm publish",
    "preversion": "npm run test",
    "test": "npm run lint && npm run test:unit",
    "test:changed": "jest --onlyChanged",
    "test:unit": "jest",
    "test:unit:watch": "npm run test:unit -- --watch",
    "version": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:code-dot-org/maze.git"
  },
  "author": "Code.org Contributors",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@swc/core": "^1.12.1",
    "@swc/jest": "^0.2.38",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.1",
    "codecov": "^3.0.0",
    "esbuild": "^0.24.2",
    "esbuild-node-externals": "^1.16.0",
    "eslint": "^9.18.0",
    "eslint-config-love": "^116.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.19.1"
  },
  "dependencies": {
    "@types/events": "^3.0.3"
  }
}
